[MASTER]
ignore=build,dist,.venv,venv

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    protected-access,
    invalid-name,
    attribute-defined-outside-init,
    not-callable,
    raise-missing-from,
    no-member,
    too-many-branches,
    too-many-locals,
    too-many-statements,
    too-few-public-methods,
    duplicate-code

[FORMAT]
max-line-length=127
